{
  "name": "walia",
  "version": "0.1.0",
  "private": true,
  "description": "Polls LinkedIn guest job search for internships and posts a digest to Telegram",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --no-warnings=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^24.13.3",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
